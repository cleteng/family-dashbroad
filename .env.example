# Database
# Local default: file:./data/app.db
# Docker default: file:/data/app.db
DATABASE_URL=file:./data/app.db

# Application public URL (used for absolute links, OAuth callbacks later)
APP_URL=http://localhost:3000

# Runtime environment
NODE_ENV=development

# Auth (TASK-003)
# Session encryption key — must be >= 32 characters. Generate:
#   openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# First administrator (only used when users table is empty)
ADMIN_EMAIL=admin@example.com
# Must be at least 12 characters
ADMIN_PASSWORD=change-me-to-a-strong-password

# Weather (TASK-014) — default Canadian postal for forecast layer
# Open-Meteo geocoding has limited postal support; J4L 3B3 falls back to Longueuil coords.
WEATHER_DEFAULT_POSTAL=J4L 3B3
